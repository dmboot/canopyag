Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Measured1
        - /Commanded (ghost)1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    # The robot as the encoders report it (/joint_states).
    - Class: rviz_default_plugins/RobotModel
      Name: Measured
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    # The robot as it is commanded (ghost_state.py), frames prefixed cmd/.
    # Where it separates from Measured, the hardware is not following.
    - Class: rviz_default_plugins/RobotModel
      Name: Commanded (ghost)
      Enabled: true
      Description Topic:
        Value: /ghost/robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      TF Prefix: cmd
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.35
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.5
      Focal Point: {X: 0.55, Y: -1.0, Z: 1.0}
      Pitch: 0.4
      Yaw: 0.9
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays: {collapsed: false}
  Views: {collapsed: false}
