Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Robot1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      # Tick to see the boxes canopyag_motion keeps apart (before its margin).
      Collision Enabled: false
      Alpha: 1
    # canopyag_motion motion_server.py: the goal (orange) and the tool point's path (blue).
    - Class: rviz_default_plugins/MarkerArray
      Name: Goal
      Enabled: true
      Topic:
        Value: /goal_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    # canopyag_motion goal_panel.py: the point being picked (green: reachable,
    # red: not) and the path to it from where the robot is now.
    - Class: rviz_default_plugins/MarkerArray
      Name: Goal preview
      Enabled: true
      Topic:
        Value: /goal_preview
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    # Click a point on something in the scene: motion_server.py sends the
    # tool point there.
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /goal_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.5
      Focal Point: {X: 0.3, Y: 0.0, Z: 0.8}
      Pitch: 0.45
      Yaw: 0.6
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays: {collapsed: false}
  Views: {collapsed: false}
