<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    canopy.ag SCARA - serial chain.

        base_link  (20x40 extrusion column, fixed to world)
          | z_lift_joint      prismatic Z   NEMA 1
        lift_link  (V-wheel carriage)
          | shoulder_joint    revolute  Z   NEMA 2
        upper_arm_link
          | elbow_joint       revolute  Z   NEMA 3
        forearm_link
          | wrist_roll_joint  revolute  Z   NEMA 4
        wrist_link
          | tool_pitch_joint  revolute  Y   NEMA 5   (least certain)
        tool_link
          | (gripper.xacro attaches here)
  -->
  <xacro:macro name="canopyag_arm" params="cfg use_meshes">

    <xacro:arm_link name="base_link"      cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_alu"/>
    <xacro:arm_link name="lift_link"      cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_black"/>
    <xacro:arm_link name="upper_arm_link" cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_green"/>
    <xacro:arm_link name="forearm_link"   cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_green"/>
    <xacro:arm_link name="wrist_link"     cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_grey"/>
    <xacro:arm_link name="tool_link"      cfg="${cfg}" use_meshes="${use_meshes}" material="canopy_grey"/>

    <xacro:arm_joint name="z_lift_joint"     parent="base_link"      child="lift_link"      J="${cfg['joints']['z_lift_joint']}"/>
    <xacro:arm_joint name="shoulder_joint"   parent="lift_link"      child="upper_arm_link" J="${cfg['joints']['shoulder_joint']}"/>
    <xacro:arm_joint name="elbow_joint"      parent="upper_arm_link" child="forearm_link"   J="${cfg['joints']['elbow_joint']}"/>
    <xacro:arm_joint name="wrist_roll_joint" parent="forearm_link"   child="wrist_link"     J="${cfg['joints']['wrist_roll_joint']}"/>
    <xacro:arm_joint name="tool_pitch_joint" parent="wrist_link"     child="tool_link"      J="${cfg['joints']['tool_pitch_joint']}"/>

  </xacro:macro>

</robot>
