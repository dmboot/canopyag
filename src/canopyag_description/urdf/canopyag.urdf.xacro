<?xml version="1.0"?>
<!--
  Top level. Every number comes from config/robot_parameters.yaml, which the
  importer regenerates from a SolidWorks export - there is nothing robot
  specific in any of the xacro files.

  Expand it by hand to check an edit:
    xacro canopyag.urdf.xacro sim:=false > /tmp/canopyag.urdf
    check_urdf /tmp/canopyag.urdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="canopyag">

  <xacro:arg name="sim"           default="true"/>
  <!-- Only read when sim is false: mock hardware instead of the CAN bus. -->
  <xacro:arg name="mock"          default="false"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="can_bitrate"   default="500000"/>
  <!-- Joint <-> motor mapping, only read on the real robot. -->
  <xacro:arg name="hardware_file"
             default="$(find canopyag_description)/config/hardware.yaml"/>
  <xacro:arg name="params_file"
             default="$(find canopyag_description)/config/robot_parameters.yaml"/>
  <xacro:arg name="controllers_file"
             default="$(find canopyag_description)/config/controllers.yaml"/>

  <xacro:include filename="$(find canopyag_description)/urdf/macros.xacro"/>
  <xacro:include filename="$(find canopyag_description)/urdf/ros2_control.xacro"/>
  <xacro:include filename="$(find canopyag_description)/urdf/gazebo.xacro"/>

  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg params_file)')}"/>
  <xacro:property name="sim" value="$(arg sim)"/>

  <xacro:build_robot cfg="${cfg}"/>

  <xacro:build_ros2_control cfg="${cfg}" sim="${sim}" mock="$(arg mock)"
                            can_interface="$(arg can_interface)"
                            can_bitrate="$(arg can_bitrate)"
                            hardware_file="$(arg hardware_file)"/>

  <xacro:if value="${sim}">
    <xacro:build_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>
